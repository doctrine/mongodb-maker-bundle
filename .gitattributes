# Auto-detect text files, ensure they use LF.
* text=auto eol=lf

# Exclude non-essential files from dist
/* export-ignore
/src -export-ignore
/src/** -export-ignore
/config -export-ignore
/config/** -export-ignore
/templates -export-ignore
/templates/** -export-ignore
/*.md -export-ignore
/composer.json -export-ignore
/phpstan-baseline.neon -export-ignore
