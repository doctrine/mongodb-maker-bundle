<?php

namespace App\Tests;

use App\Document\User;
use Doctrine\ODM\MongoDB\DocumentManager;
use Symfony\Bundle\FrameworkBundle\Test\KernelTestCase;

class GeneratedDocumentTest extends KernelTestCase
{
    public function testGeneratedDocument()
    {
        self::bootKernel();
        /** @var DocumentManager $dm */
        $dm = self::$kernel->getContainer()
            ->get('doctrine_mongodb')
            ->getManager();

        $schemaManager = $dm->getSchemaManager();

        $schemaManager->createDocumentCollection(User::class);
        $schemaManager->deleteDocumentIndexes(User::class);
        $schemaManager->ensureIndexes();

        $iterator = $dm->getDocumentCollection(User::class)->listIndexes();
        $indexes = [];

        while ($current = $iterator->current()) {
            if ($current['name'] !== '_id_') {
                $indexes[] = [
                    'unique' => $current['unique'] ?? false,
                    'keys' => $current['key'],
                ];
            }
            $iterator->next();
        }

        $expected = json_decode('{{ data|json_encode|raw }}', true);

        $this->assertSame($expected, $indexes);
    }
}
